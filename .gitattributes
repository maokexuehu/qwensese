# 统一换行：脚本保持系统原生换行，文本文件统一 LF
* text=auto
*.py  text eol=lf
*.js  text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.ico binary
*.gguf binary
